# Copie para .env (no computador) ou cadastre na Vercel em Settings > Environment Variables.
# Nunca envie o .env para o GitHub.

APP_NOME=ADSTEK

# Banco: MySQL na nuvem (TiDB Cloud, Aiven, Railway...). Com TiDB: porta 4000 e DB_SSL=1
DB_DRIVER=mysql
DB_HOST=
DB_PORT=4000
DB_NAME=adstek
DB_USER=
DB_PASS=
DB_SSL=1
# DB_SSL_CA=/caminho/ca.pem   (só se o banco exigir um certificado próprio)

# No computador, para testar sem MySQL (Node 22.5+):
# DB_DRIVER=sqlite
# DB_PATH=adstek.sqlite

# Segurança (textos longos e aleatórios; não troque a APP_SEGREDO depois de cadastrar chaves)
APP_SEGREDO=
CRON_SECRET=
SESSAO_HORAS=12

# Primeiro administrador (criado no primeiro acesso). Depois de entrar e trocar a senha, apague ADMIN_SENHA.
ADMIN_NOME=
ADMIN_EMAIL=
ADMIN_SENHA=
IMPORTAR_CONTAS=1

# Instalação manual pela tela /instalar.php (opcional, mínimo 8 caracteres)
INSTALAR_CODIGO=

# Chaves dos serviços (opcional: o melhor é cadastrar em Integrações > Serviços, criptografadas no banco)
ADSPIRER_KEY=
ANTHROPIC_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
META_TOKEN=
META_APP_SECRET=
META_API_VERSION=v26.0

# Servidor próprio (npm start)
PORT=8080
# PILOTO_INTERNO=0   (desliga o agendador interno de 5 em 5 minutos)
# ATRAS_DE_PROXY=1   (pega o IP do visitante do cabeçalho do proxy)
